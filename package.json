{
  "name": "digital-sponsor",
  "version": "1.0.0",
  "description": "AI-powered AA literature companion for underserved recovery community members",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build --workspace=packages/shared",
    "dev": "npm run dev --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e:staging": "npm run test:e2e --workspace=apps/web --if-present -- --env=staging",
    "test:e2e:production": "npm run test:e2e --workspace=apps/web --if-present -- --env=production",
    "test:prod": "npm run test:prod --workspaces --if-present",
    "test:lighthouse": "npm run test:lighthouse --workspace=apps/web --if-present",
    "test:coverage": "npm run test:coverage --workspaces",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 10",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "type-check": "npm run type-check --workspaces",
    "license-check": "npm run license-check --workspaces --if-present || echo 'License check not configured'",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.7",
    "@playwright/test": "^1.58.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/digital-sponsor.git"
  },
  "keywords": [
    "aa",
    "alcoholics-anonymous",
    "recovery",
    "ai",
    "literature",
    "azure",
    "typescript"
  ],
  "author": "Digital Sponsor Team",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "^1.16.0"
  }
}
