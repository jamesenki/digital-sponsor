{
  "name": "digital-sponsor-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Sponsor Backend API",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/simple-server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/simple-server.ts",
    "dev:full": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__/services",
    "test:integration": "jest --testPathPattern=__tests__/routes",
    "test:all": "jest --coverage --verbose",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "chromadb": "^1.7.3",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.1",
    "express-rate-limit": "^6.7.0",
    "express-session": "^1.17.3",
    "helmet": "^6.0.1",
    "joi": "^17.7.1",
    "jsonwebtoken": "^9.0.0",
    "knex": "^2.4.2",
    "markdown-it": "^14.0.0",
    "openai": "^4.28.4",
    "pdf-parse": "^1.1.1",
    "pg": "^8.9.0",
    "redis": "^4.6.4",
    "uuid": "^9.0.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/markdown-it": "^13.0.7",
    "@types/node": "^18.14.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.6.6",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "eslint": "^8.35.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^30.2.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
