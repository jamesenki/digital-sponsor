# Digital Sponsor Backend Environment Variables
# Copy this file to .env and update with your values

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://digital_sponsor:secure_password_2024@localhost:5432/digital_sponsor_db
REDIS_URL=redis://localhost:6380
CHROMA_URL=http://localhost:8000

# Session Configuration
SESSION_SECRET=digital-sponsor-anonymous-sessions-2024-change-in-production

# OpenAI Configuration (for RAG system)
OPENAI_API_KEY=your-openai-api-key-here

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=logs

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AA Traditions Compliance
AA_TRADITIONS_COMPLIANT=true
ANONYMOUS_SESSIONS_ONLY=true
NO_PERSONAL_DATA_COLLECTION=true