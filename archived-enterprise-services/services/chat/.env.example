# Digital Sponsor Chat Service Configuration

# Server Configuration
NODE_ENV=development
PORT=3003
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_MODEL=gpt-4
AZURE_OPENAI_MAX_TOKENS=1000
AZURE_OPENAI_TEMPERATURE=0.7
AZURE_OPENAI_TOP_P=0.95
AZURE_OPENAI_FREQUENCY_PENALTY=0
AZURE_OPENAI_PRESENCE_PENALTY=0
AZURE_OPENAI_CONTENT_FILTERING=true
AZURE_OPENAI_MODERATION_CHECK=true

# Literature Service Integration
LITERATURE_SERVICE_URL=http://localhost:3002

# RAG Configuration
RAG_MAX_SOURCES=5
RAG_RELEVANCE_THRESHOLD=0.6
RAG_SEARCH_TIMEOUT=5000
RAG_INCLUDE_METADATA=true

# Cosmos DB Configuration (use one of the following)
# Option 1: Connection String
COSMOS_CONNECTION_STRING=AccountEndpoint=https://your-account.documents.azure.com:443/;AccountKey=your_key==;

# Option 2: Endpoint and Key (if not using connection string)
# COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
# COSMOS_KEY=your_key

# Database Configuration
COSMOS_DATABASE_NAME=DigitalSponsor
COSMOS_CONVERSATIONS_CONTAINER=Conversations

# Conversation Management
CONVERSATION_MAX_CONTEXT=50
CONVERSATION_RETENTION_DAYS=30
CONVERSATION_AUTO_SUMMARY=true

# Feature Flags
ENABLE_RAG=true
ENABLE_CRISIS_DETECTION=true
ENABLE_RECOMMENDATIONS=true

# Azure Identity (if using Managed Identity)
# AZURE_CLIENT_ID=your_managed_identity_client_id