# Authentication Service Configuration

# Environment
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=0.0.0.0

# Azure AD B2C Configuration
B2C_TENANT_NAME=digitalsponsordev
B2C_TENANT_DOMAIN=digitalsponsordev.onmicrosoft.com
B2C_CLIENT_ID=your-b2c-client-id
B2C_CLIENT_SECRET=your-b2c-client-secret
B2C_POLICY_NAME=B2C_1_SignUpSignIn
B2C_EDIT_PROFILE_POLICY=B2C_1_EditProfile
B2C_PASSWORD_RESET_POLICY=B2C_1_PasswordReset

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
SESSION_PREFIX=auth:session:
SESSION_TTL=3600

# Azure Key Vault
KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# AA Traditions Compliance
AA_ANONYMOUS_MODE_DEFAULT=true
AA_DATA_RETENTION_DEFAULT=session
AA_PII_LOGGING_ENABLED=false