# Digital Sponsor - Environment Configuration Template
# Copy this file to .env and fill in your values

# Application Environment
NODE_ENV=development
APP_NAME=Digital Sponsor
APP_VERSION=0.1.0
APP_URL=http://localhost:3000

# Server Configuration
API_PORT=3000
API_HOST=localhost
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://digital_sponsor:password@localhost:5432/digital_sponsor_dev
REDIS_URL=redis://localhost:6379
REDIS_SESSION_PREFIX=ds_session:

# Vector Database (Chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=aa_literature
CHROMA_PERSIST_DIRECTORY=./chroma_db

# AI/ML Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Literature Processing
LITERATURE_PATH=./literature
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=50
CITATION_FORMAT="{source}, Page {page}"

# Security Configuration
JWT_SECRET=your-very-secure-jwt-secret-key-here
SESSION_SECRET=your-very-secure-session-secret-here
ENCRYPTION_KEY=your-32-character-encryption-key
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT=50
SEARCH_RATE_LIMIT=30

# Meeting Services
MEETING_GUIDE_API_KEY=your-meeting-guide-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
DEFAULT_SEARCH_RADIUS=10
MAX_SEARCH_RADIUS=50

# File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,docx,xlsx

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn-here
ANALYTICS_ENABLED=true
PLAUSIBLE_DOMAIN=digitalsponsor.org
PLAUSIBLE_API_KEY=your-plausible-api-key

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@digitalsponsor.org

# Crisis Support
CRISIS_HOTLINES_API=https://api.crisisresources.org
ENABLE_CRISIS_BUTTON=true
CRISIS_CACHE_TTL=86400

# Privacy & Compliance
ANONYMOUS_SESSIONS=true
SESSION_TTL=86400
AUTO_DELETE_SESSIONS=true
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=7

# Development Tools
DEBUG=digital-sponsor:*
ENABLE_SWAGGER=true
MOCK_EXTERNAL_APIS=false
SEED_DATABASE=true

# Testing
TEST_DATABASE_URL=postgresql://digital_sponsor:password@localhost:5432/digital_sponsor_test
TEST_REDIS_URL=redis://localhost:6379/1
E2E_BASE_URL=http://localhost:3000

# Docker Configuration
POSTGRES_USER=digital_sponsor
POSTGRES_PASSWORD=password
POSTGRES_DB=digital_sponsor_dev
POSTGRES_PORT=5432

# Production Overrides (set these in production)
# DATABASE_URL=postgresql://user:pass@prod-host:5432/digital_sponsor
# REDIS_URL=redis://prod-redis:6379
# OPENAI_API_KEY=sk-prod-key
# JWT_SECRET=production-jwt-secret
# SESSION_SECRET=production-session-secret
# ENCRYPTION_KEY=production-encryption-key