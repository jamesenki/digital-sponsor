{
  "name": "@digital-sponsor/auth-functions-slim",
  "version": "1.0.0",
  "description": "Digital Sponsor Authentication Functions - Optimized",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "clean": "rimraf dist node_modules/.cache"
  },
  "dependencies": {
    "@azure/functions": "^4.11.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "optionalDependencies": {
    "@azure/identity": "^4.0.1",
    "@azure/keyvault-secrets": "^4.8.0",
    "redis": "^4.6.10",
    "winston": "^3.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bundledDependencies": [],
  "config": {
    "optimize": {
      "treeshake": true,
      "minify": true,
      "excludeDevDependencies": true
    }
  }
}
